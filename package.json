{
  "name": "agents-ssh-cli",
  "version": "1.0.0",
  "description": "SSH remote management CLI - execute commands, upload/download files via SSH",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agents-ssh-cli": "dist/cli.js"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "ssh2": "^1.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "ssh",
    "cli",
    "remote",
    "command",
    "file-transfer"
  ],
  "author": "",
  "license": "MIT"
}
